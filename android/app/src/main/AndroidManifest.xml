<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Watches the accelerometer once the app is no longer on screen.
             specialUse, with the subtype spelled out, because none of the
             predefined foreground service types describes crash detection and
             claiming one that does not fit would be a lie told to the system. -->
        <service
            android:name=".CrashWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="crash_detection" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Android 11 hides other packages from this one unless they are named
         here, and both the speech recogniser and the speech engine live in
         other packages. Without this block isRecognitionAvailable() returns
         false on every modern phone and hands-free help silently never arms
         itself — the failure looks exactly like a device with no microphone,
         which is why it is worth a comment rather than four quiet lines. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Android 11 hid other packages from us. Without this line
             setPackage("com.whatsapp") throws ActivityNotFoundException on
             a phone that has WhatsApp installed and working - the same trap
             that made isRecognitionAvailable() return false above. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Crash response. Each of these exists so that the countdown can finish
         without the rider touching the phone, which is the whole point: after
         a bad fall they may not be able to. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Where the rider is, which is the first thing a contact needs to know. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Recording what is happening around the car after an impact. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Watching the sensor once the screen is off, which is how a rider
         actually carries a phone. A foreground service keeps the process
         alive; the wake lock keeps the CPU awake, without which the device
         dozes and sensor callbacks simply stop arriving. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The alert has to reach a locked, dark phone. POST_NOTIFICATIONS is
         asked for at runtime on Android 13 and later; the full-screen intent
         is the same mechanism an alarm clock uses to get a screen up. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- So the app can offer the exemption dialog itself. Without the
         exemption many phones kill the service after minutes in a pocket,
         which is exactly the case crash watch exists for. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The app is useful without a SIM, so none of the telephony hardware is
         required to install it. Without these a tablet could not install the
         app at all, because requesting SEND_SMS implies telephony hardware. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
