# Secrets: keys go in .env.local, never in git
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Build output
dist/
build/
.next/
out/
.vercel/
.turbo/
coverage/

# Model weights and big data: download them, don't commit them
*.gguf
*.safetensors
*.bin
*.onnx
*.pt
*.ckpt

# Blender framing checks. The finished render and the .blend are kept; these
# are the throwaway stills used to check a shot before committing to it.
docs/pitch-assets/still_*.png

# Blender writes a .blend1 backup beside every save. The .blend is kept; its
# backup is noise.
*.blend1

# Logs and OS junk
*.log
.DS_Store
Thumbs.db
.idea/

# Vite / editor extras
dist-ssr/
*.local
.vscode/*
!.vscode/extensions.json
*.sw?

# Local Claude Code / tool config
.claude/
